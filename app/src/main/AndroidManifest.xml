<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Quick menu's brightness slider and Do Not Disturb (spec 4.6). The player allows each once in Android's settings. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <!-- The Apps library lists what a home screen lists: apps with a launcher entry, and no others.
         QUERY_ALL_PACKAGES is deliberately not requested (ADR 0021). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- allowNativeHeapPointerTagging is off because the PlayStation 2 engine's own app has it off: an engine
         that learns which of a game's memory was touched from the address of a fault compares that address with
         ones it took from the heap, and a tagged heap address never matches the plain one a fault reports. Games
         were run on the device with it off only (docs/CONSOLES, PlayStation 2). -->
    <application android:label="${appLabel}" android:theme="@style/Theme.Cartridge"
        android:icon="@drawable/ic_cartridge" android:dataExtractionRules="@xml/data_extraction_rules"
        android:allowBackup="false" android:supportsRtl="true" android:allowNativeHeapPointerTagging="false">
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".CartridgeHome" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:label="${appLabel}">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
